{
  "id": "qwen_image_gen_v1",
  "name": "Qwen Image Generation",
  "category": "general_generation",
  "version": 1,
  "description": "Text-to-image with the Qwen Image Edit GGUF model (4-step euler).",
  "inputs": {
    "prompt": {
      "node_id": "16",
      "input_name": "prompt",
      "type": "text",
      "required": true
    },
    "negative_prompt": {
      "node_id": "25",
      "input_name": "text",
      "type": "text",
      "required": false,
      "default": ""
    },
    "width": {
      "node_id": "15",
      "input_name": "width",
      "type": "width",
      "required": true,
      "default": 800
    },
    "height": {
      "node_id": "15",
      "input_name": "height",
      "type": "height",
      "required": true,
      "default": 1024
    },
    "batch_size": {
      "node_id": "15",
      "input_name": "batch_size",
      "type": "number",
      "required": false,
      "default": 1
    },
    "seed": {
      "node_id": "3",
      "input_name": "noise_seed",
      "type": "seed",
      "required": false
    },
    "steps": {
      "node_id": "3",
      "input_name": "steps",
      "type": "number",
      "required": false,
      "default": 4
    },
    "cfg": {
      "node_id": "3",
      "input_name": "cfg",
      "type": "number",
      "required": false,
      "default": 1
    }
  },
  "outputs": {
    "images": [
      {
        "node_id": "13",
        "output_type": "images"
      }
    ]
  }
}
